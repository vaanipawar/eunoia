# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git. Never commit it.

# Must match POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL=postgresql://eunoia_user:CHANGE_ME@postgres:5432/eunoia
REDIS_URL=redis://redis:6379/0

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Needed for password-reset and high-risk alert emails
SENDGRID_API_KEY=
FROM_EMAIL=noreply@eunoia.app